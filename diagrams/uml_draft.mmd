classDiagram
    class Task {
        +str description
        +time time
        +date due_date
        +str frequency
        +bool is_completed
        +int duration_minutes
        +Priority priority
        +mark_complete()
        +mark_incomplete()
        +create_next_occurrence(completed_on) Task
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +Task[] tasks
        +add_task(task)
    }

    class Owner {
        +str name
        +Pet[] pets
        +add_pet(pet)
        +get_all_tasks() Task[]
    }

    class Scheduler {
        +get_all_tasks(owner) Task[]
        +get_pending_tasks(owner) Task[]
        +filter_tasks(owner, is_completed, pet_name) Task[]
        +sort_by_time(tasks) Task[]
        +organize_tasks(owner) Task[]
        +find_conflicts(owner) TaskConflict[]
        +get_conflict_warnings(owner) str[]
        +add_task(owner, pet, task)
        +mark_task_complete(owner, task)
    }

    class TaskConflict {
        +Pet first_pet
        +Task first_task
        +Pet second_pet
        +Task second_task
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : ordered by
    Scheduler ..> Owner : retrieves all tasks from
    Scheduler ..> TaskConflict : reports overlapping tasks
